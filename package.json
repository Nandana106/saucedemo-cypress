{
  "name": "saucedemo-cypress",
  "version": "1.0.0",
  "description": "Cypress automation framework for SauceDemo",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:auth": "cypress run --spec 'cypress/e2e/authentication/**/*.cy.js'",
    "report:merge": "mochawesome-merge cypress/reports/*.json -o cypress/reports/merged.json",
    "report:generate": "marge cypress/reports/merged.json -f report -o cypress/reports/html",
    "report": "npm run report:merge && npm run report:generate"
  },
  "author": "Nandana",
  "devDependencies": {
    "cypress": "^15.21.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
